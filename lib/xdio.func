#!/usr/bin/env bash
# xdio scripts — gedeelde branding voor Proxmox LXC-scripts (s4ndyp/scripts)

[[ -n "${_XDIO_FUNC_LOADED:-}" ]] && return 0
_XDIO_FUNC_LOADED=1

_xdio_apply_tags() {
  if [[ -n "${TAGS:-}" ]]; then
    TAGS="${TAGS//community-script/xdio-script}"
  else
    TAGS="xdio-script${var_tags:+;${var_tags}}"
  fi
  export TAGS
}

_xdio_print_banner() {
  local banner_file url
  banner_file="$(dirname "${BASH_SOURCE[0]}")/xdio-banner.ans"
  url="${COMMUNITY_SCRIPTS_URL:-https://raw.githubusercontent.com/s4ndyp/scripts/main}/lib/xdio-banner.ans"

  if [[ -s "$banner_file" ]]; then
    cat "$banner_file"
    return 0
  fi
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$url" 2>/dev/null && return 0
  fi
  echo "xdio scripts"
}

if declare -f base_settings >/dev/null 2>&1; then
  eval "$(declare -f base_settings | sed '1s/base_settings/_xdio_cs_base_settings/')"
  base_settings() {
    _xdio_cs_base_settings "$@"
    _xdio_apply_tags
  }
fi

header_info() {
  if declare -f _cs_clear >/dev/null 2>&1; then
    _cs_clear
  else
    clear 2>/dev/null || true
  fi
  _xdio_print_banner
  printf '\033[0m\n  %s\n' "${APP:-}"
}
