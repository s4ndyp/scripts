#!/usr/bin/env bash
# xdio scripts — gedeelde branding voor Proxmox LXC-scripts (s4ndyp/scripts)

[[ -n "${_XDIO_FUNC_LOADED:-}" ]] && return 0
_XDIO_FUNC_LOADED=1

read -r -d '' _XDIO_BANNER <<'EOF' || true
 __   __    _ _                       _       _       
\ \ / /   | (_)                     (_)     | |      
 \ V /  __| |_  ___    ___  ___ _ __ _ _ __ | |_ ___ 
 /   \ / _` | |/ _ \  / __|/ __| '__| | '_ \| __/ __|
/ /^\ \ (_| | | (_) | \__ \ (__| |  | | |_) | |_\__ \
\/   \/\__,_|_|\___/  |___/\___|_|  |_| .__/ \__|___/
                                      | |            
                                      |_|
EOF

# Horizontaal regenboogverloop (truecolor), kolom over volledige bannerbreedte.
_xdio_rainbow_fg() {
  local col=$1 max=$2
  local h r g b s=255 v=255
  if ((max < 1)); then
    max=1
  fi
  h=$(( col * 360 / max ))
  local c x f p q t
  c=$(( h / 60 ))
  x=$(( h % 60 ))
  f=$(( x * 255 / 60 ))
  p=$(( (v * (255 - s)) / 255 ))
  q=$(( (v * (255 - (s * f / 255))) / 255 ))
  t=$(( (v * (255 - (s * (255 - f) / 255))) / 255 ))
  case "$c" in
  0) r=$v; g=$t; b=$p ;;
  1) r=$q; g=$v; b=$p ;;
  2) r=$p; g=$v; b=$t ;;
  3) r=$p; g=$q; b=$v ;;
  4) r=$t; g=$p; b=$v ;;
  *) r=$v; g=$p; b=$q ;;
  esac
  printf '\033[38;2;%d;%d;%dm' "$r" "$g" "$b"
}

_xdio_banner_max_width() {
  local w=0 ln
  while IFS= read -r ln; do
    ((${#ln} > w)) && w=${#ln}
  done <<< "$_XDIO_BANNER"
  echo "$w"
}

_xdio_print_rainbow_banner() {
  local max_w ch x colored
  max_w="$(_xdio_banner_max_width)"
  while IFS= read -r ln || [[ -n "$ln" ]]; do
    colored=""
    for ((x = 0; x < ${#ln}; x++)); do
      ch="${ln:x:1}"
      if [[ "$ch" == " " ]]; then
        colored+=" "
      else
        colored+="$(_xdio_rainbow_fg "$x" "$max_w")$ch"
      fi
    done
    printf '%b\033[0m\n' "$colored"
  done <<< "$_XDIO_BANNER"
}

_xdio_print_banner() {
  if [[ "${TERM:-}" == "dumb" ]] || [[ ! -t 1 ]]; then
    printf '%s\n' "$_XDIO_BANNER"
    return 0
  fi
  _xdio_print_rainbow_banner
}

# Statisch netwerk (Default / App / Generated), tenzij var_net gezet of XDIO_STATIC_NET=0
export XDIO_STATIC_NET="${XDIO_STATIC_NET:-1}"
export XDIO_NET_PREFIX="${XDIO_NET_PREFIX:-10.5.0}"
export XDIO_GATEWAY="${XDIO_GATEWAY:-10.5.0.1}"
export XDIO_NET_CIDR="${XDIO_NET_CIDR:-16}"
export XDIO_DNS="${XDIO_DNS:-10.5.0.110 10.5.0.111}"
export XDIO_VLAN="${XDIO_VLAN:-5}"

# Proxmox LXC Notes + MOTD (zelfde defaults als lib/xdio-motd.sh)
export XDIO_PROVIDER_NAME="${XDIO_PROVIDER_NAME:-Xdio scripts}"
export XDIO_PROVIDER_GITHUB="${XDIO_PROVIDER_GITHUB:-https://github.com/s4ndyp/scripts}"

_xdio_use_static_network() {
  [[ "${XDIO_STATIC_NET}" == "0" ]] && return 1
  case "${METHOD:-}" in
  default | appdefaults | generated) ;;
  *) return 1 ;;
  esac
  [[ -n "${var_net:-}" ]] && return 1
  return 0
}

_xdio_pre_base_settings() {
  _xdio_use_static_network || return 0
  if [[ -z "${var_vlan:-}" ]]; then
    var_vlan="${XDIO_VLAN}"
    export var_vlan
  fi
}

_xdio_post_base_settings() {
  _xdio_use_static_network || return 0
  [[ -z "${CT_ID:-}" ]] && return 0
  NET="${XDIO_NET_PREFIX}.${CT_ID}/${XDIO_NET_CIDR}"
  GATE="${var_gateway:-${XDIO_GATEWAY}}"
  export NET GATE
  if [[ -z "${var_ns:-}" ]]; then
    XDIO_DNS_FULL="${XDIO_DNS}"
    var_ns="${XDIO_DNS}"
    NS="-nameserver=$(echo "$XDIO_DNS" | awk '{print $1}')"
    export var_ns NS XDIO_DNS_FULL
  fi
}

_xdio_pct_create() {
  _xdio_cs_pct_create "$@"
  local rc=$?
  if ((rc == 0)) && [[ -n "${XDIO_DNS_FULL:-}" ]] && [[ "$XDIO_DNS_FULL" == *[[:space:]]* ]]; then
    pct set "$1" --nameserver "$XDIO_DNS_FULL" >>"${BUILD_LOG:-/dev/null}" 2>&1 || true
  fi
  return "$rc"
}

_xdio_apply_tags() {
  if [[ -n "${TAGS:-}" ]]; then
    TAGS="${TAGS//community-script/xdio-script}"
  else
    TAGS="xdio-script${var_tags:+;${var_tags}}"
  fi
  export TAGS
}

if declare -f base_settings >/dev/null 2>&1; then
  eval "$(declare -f base_settings | sed '1s/base_settings/_xdio_cs_base_settings/')"
  base_settings() {
    _xdio_pre_base_settings
    _xdio_cs_base_settings "$@"
    _xdio_post_base_settings
    _xdio_apply_tags
  }
fi

if declare -f _pct_create >/dev/null 2>&1; then
  eval "$(declare -f _pct_create | sed '1s/_pct_create/_xdio_cs_pct_create/')"
  _pct_create() {
    _xdio_pct_create "$@"
  }
fi

header_info() {
  if declare -f _cs_clear >/dev/null 2>&1; then
    _cs_clear
  else
    clear 2>/dev/null || true
  fi
  _xdio_print_banner
  echo "  ${APP:-}"
}

# Proxmox UI container description (community-scripts/core description() marketing → xdio)
_xdio_description_testing_block() {
  [[ -n "${CS_TESTING_URL:-}" ]] || return 0
  local _url_html="${CS_TESTING_URL//&/&amp;}"
  local _label="Report%20feedback"
  if [[ "$CS_TESTING_URL" =~ /(issues|discussions)/([0-9]+)$ ]]; then
    _label="Report%20feedback%20%23${BASH_REMATCH[2]}"
  fi
  cat <<EOF
<div align='center'>
  <p style='margin: 4px 0 12px 0;'>
    <a href='${_url_html}' target='_blank' rel='noopener noreferrer'>
      <img src='https://img.shields.io/badge/%E2%9A%A0%EF%B8%8F-TESTING%20BUILD-d97706' alt='Testing build' />
    </a>
  </p>

  <p style='margin: 8px 16px; font-size: 13px;'>This script is still being tested.<br/>Without feedback it cannot be finished.</p>

  <p style='margin: 12px 0;'>
    <a href='${_url_html}' target='_blank' rel='noopener noreferrer'>
      <img src='https://img.shields.io/badge/%F0%9F%92%AC-${_label}-2ea043' alt='Report feedback' />
    </a>
  </p>

  <p style='margin: 8px 16px 16px 16px; font-size: 12px;'>Works, broken, or anything odd &mdash; one line is enough.</p>
</div>
EOF
}

_xdio_build_container_description() {
  local testing_block="${1:-}"
  local repo_slug repo_url script_slug script_url provider_name provider_url
  repo_slug="${REPO_SLUG:-s4ndyp/scripts}"
  repo_url="https://github.com/${repo_slug}"
  provider_name="${XDIO_PROVIDER_NAME}"
  provider_url="${XDIO_PROVIDER_GITHUB:-$repo_url}"
  script_slug="${SCRIPT_SLUG:-${NSAPP:-$APP}}"
  script_slug="$(printf '%s' "$script_slug" | tr '[:upper:]' '[:lower:]' | tr -d ' ')"
  if [[ -n "${XDIO_SCRIPT_URL:-}" ]]; then
    script_url="${XDIO_SCRIPT_URL}"
  else
    script_url="${repo_url}/blob/main/${script_slug}/${script_slug}.sh"
  fi
  cat <<EOF
${testing_block}
<div align='center'>
  <p style='margin: 16px 0 8px 0; font-size: 18px; font-weight: 600;'>
    <a href='${provider_url}' target='_blank' rel='noopener noreferrer' style='text-decoration: none; color: #00617f;'>${provider_name}</a>
  </p>

  <h2 style='font-size: 24px; margin: 20px 0;'>${APP} LXC</h2>

  <p style='margin: 12px 0;'>
    <a href='${script_url}' target='_blank' rel='noopener noreferrer'>
      <img src='https://img.shields.io/badge/%F0%9F%93%9C-Install%20script-00617f' alt='Install script' />
    </a>
  </p>

  <span style='margin: 0 10px;'>
    <i class="fa fa-github fa-fw" style="color: #f5f5f5;"></i>
    <a href='${repo_url}' target='_blank' rel='noopener noreferrer' style='text-decoration: none; color: #00617f;'>GitHub</a>
  </span>
  <span style='margin: 0 10px;'>
    <i class="fa fa-comments fa-fw" style="color: #f5f5f5;"></i>
    <a href='${repo_url}/discussions' target='_blank' rel='noopener noreferrer' style='text-decoration: none; color: #00617f;'>Discussions</a>
  </span>
  <span style='margin: 0 10px;'>
    <i class="fa fa-exclamation-circle fa-fw" style="color: #f5f5f5;"></i>
    <a href='${repo_url}/issues' target='_blank' rel='noopener noreferrer' style='text-decoration: none; color: #00617f;'>Issues</a>
  </span>
</div>
EOF
}

_xdio_description_finish() {
  if [[ -n "${CS_TESTING_URL:-}" ]]; then
    msg_custom "🔗" "${YW}" "Testing build — please report back: ${CS_TESTING_URL}"
  fi

  if [[ -f /etc/systemd/system/ping-instances.service ]]; then
    systemctl start ping-instances.service
  fi

  if [[ -n "${var_post_install:-}" ]]; then
    local _hook_log_dir="/var/log/community-scripts"
    local _hook_log="${_hook_log_dir}/post-install-${CTID}.log"
    mkdir -p "$_hook_log_dir" 2>/dev/null || true

    if [[ ! -f "${var_post_install}" ]]; then
      msg_error "Post-install hook not found on host: ${var_post_install}"
      whiptail --backtitle "Proxmox VE Helper Scripts" \
        --title "POST-INSTALL HOOK FAILED" \
        --msgbox "The configured post-install hook was not found on the Proxmox host:\n\n${var_post_install}\n\nThe LXC was created successfully, but the hook did NOT run." 14 72 || true
    else
      msg_info "Running post-install hook: ${var_post_install}"
      local _hook_rc=0
      APP="$APP" NSAPP="${NSAPP:-}" CTID="$CTID" IP="$IP" HN="${HN:-}" \
        STORAGE="${STORAGE:-}" BRG="${BRG:-}" \
        bash "${var_post_install}" >"${_hook_log}" 2>&1 || _hook_rc=$?
      if [[ $_hook_rc -eq 0 ]]; then
        msg_ok "Post-install hook completed (log: ${_hook_log})"
      else
        msg_error "Post-install hook failed (rc=${_hook_rc}) – see ${_hook_log}"
        local _hook_tail=""
        _hook_tail="$(tail -n 15 "${_hook_log}" 2>/dev/null || true)"
        whiptail --backtitle "Proxmox VE Helper Scripts" \
          --title "POST-INSTALL HOOK FAILED" \
          --msgbox "Hook exited with code ${_hook_rc}.\n\nScript: ${var_post_install}\nLog:    ${_hook_log}\n\n--- Last log lines ---\n${_hook_tail}\n\nThe LXC itself was created successfully." 22 78 || true
      fi
    fi
  fi

  post_update_to_api "done" "none"
}

if declare -f description >/dev/null 2>&1; then
  eval "$(declare -f description | sed '1s/description/_xdio_cs_description/')"
  description() {
    IP=$(pct exec "$CTID" ip a s dev eth0 | awk '/inet / {print $2}' | cut -d/ -f1)
    local _testing_block=""
    _testing_block="$(_xdio_description_testing_block)"
    DESCRIPTION="$(_xdio_build_container_description "$_testing_block")"
    pct set "$CTID" -description "$DESCRIPTION"
    _xdio_description_finish
  }
fi
