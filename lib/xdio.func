#!/usr/bin/env bash
# xdio scripts — gedeelde branding en netwerk voor Proxmox LXC-scripts (s4ndyp/scripts)

[[ -n "${_XDIO_FUNC_LOADED:-}" ]] && return 0
_XDIO_FUNC_LOADED=1

# Vast IP-schema: 10.5.0.<CTID>/16, gateway 10.5.0.1 (alleen Default / App / Generated install)
export XDIO_STATIC_NET="${XDIO_STATIC_NET:-1}"
export XDIO_NET_PREFIX="${XDIO_NET_PREFIX:-10.5.0}"
export XDIO_GATEWAY="${XDIO_GATEWAY:-10.5.0.1}"
export XDIO_NET_CIDR="${XDIO_NET_CIDR:-16}"
# DNS (spatie-gescheiden). pct create krijgt alleen het 1e adres (PCT_OPTIONS wordt
# unquoted gesplit); volledige lijst wordt direct na create gezet via pct set.
export XDIO_DNS="${XDIO_DNS:-10.5.0.110 10.5.0.111}"

_XDIO_BANNER='   __  __ ______  ____   _____           _       __
   \ \/ // __  \/ __ \ / ___/___  ____  (_)___  / /______
    \  // / / / / / / / \__ \/ _ \/ __ \/ / __ \/ __/ ___/
    / // /_/ / / /_/ / ___/ /  __/ / / / / /_/ / /_(__  )
   /_/ \____/  \____/ /____/\___/_/ /_/_/\____/\__/____/
                         Scripts'

_xdio_apply_static_net() {
  [[ "${XDIO_STATIC_NET}" == "0" ]] && return 0
  case "${METHOD:-}" in
  default | appdefaults | generated) ;;
  *) return 0 ;;
  esac
  if [[ -n "${var_net:-}" ]]; then
    return 0
  fi
  if [[ -z "${CT_ID:-}" ]]; then
    return 0
  fi
  NET="${XDIO_NET_PREFIX}.${CT_ID}/${XDIO_NET_CIDR}"
  GATE="${var_gateway:-${XDIO_GATEWAY}}"
  export NET GATE
}

_xdio_apply_dns() {
  if [[ "${NET:-dhcp}" == "dhcp" || "${NET:-}" == "manual" || -z "${NET:-}" ]]; then
    unset XDIO_DNS_FULL
    return 0
  fi
  local dns="${var_ns:-$XDIO_DNS}"
  [[ -z "$dns" ]] && return 0
  XDIO_DNS_FULL="$dns"
  var_ns="$dns"
  # Eén token voor pct create (community-scripts: $PCT_OPTIONS zonder quotes).
  NS="-nameserver=$(echo "$dns" | awk '{print $1}')"
  export var_ns NS XDIO_DNS_FULL
}

_xdio_pct_create() {
  _xdio_cs_pct_create "$@"
  local rc=$?
  if ((rc == 0)) && [[ -n "${XDIO_DNS_FULL:-}" ]] && [[ "$XDIO_DNS_FULL" == *[[:space:]]* ]]; then
    pct set "$1" --nameserver "$XDIO_DNS_FULL" >>"${BUILD_LOG:-/dev/null}" 2>&1 || true
  fi
  return "$rc"
}

_xdio_apply_tags() {
  if [[ -n "${TAGS:-}" ]]; then
    TAGS="${TAGS//community-script/xdio-script}"
  else
    TAGS="xdio-script${var_tags:+;${var_tags}}"
  fi
  export TAGS
}

if declare -f base_settings >/dev/null 2>&1; then
  eval "$(declare -f base_settings | sed '1s/base_settings/_xdio_cs_base_settings/')"
  base_settings() {
    _xdio_cs_base_settings "$@"
    _xdio_apply_static_net
    _xdio_apply_dns
    _xdio_apply_tags
  }
fi

if declare -f _pct_create >/dev/null 2>&1; then
  eval "$(declare -f _pct_create | sed '1s/_pct_create/_xdio_cs_pct_create/')"
  _pct_create() {
    _xdio_pct_create "$@"
  }
fi

header_info() {
  local term_width
  term_width=$(tput cols 2>/dev/null || echo 120)
  if declare -f _cs_clear >/dev/null 2>&1; then
    _cs_clear
  else
    clear 2>/dev/null || true
  fi
  echo "${_XDIO_BANNER}"
  echo "  ${APP:-}"
}
